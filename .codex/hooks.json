{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd prime --mcp --stealth",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime --mcp --stealth",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --mcp --stealth",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash -c 'repo=$(git rev-parse --show-toplevel 2\u003e/dev/null) || { printf \"%s\\n\" \"{\\\"continue\\\":true,\\\"stopReason\\\":\\\"auto-delivery: skipped - not a git repo\\\"}\"; exit 0; }; cd \"$repo\" \u0026\u0026 exec scripts/auto-deliver-on-complete.sh --hook'",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd prime --mcp --stealth",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      }
    ]
  }
}
