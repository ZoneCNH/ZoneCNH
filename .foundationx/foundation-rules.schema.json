{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZoneCNH/ZoneCNH/.foundationx/foundation-rules.schema.json",
  "title": "Foundation Module Rules Matrix",
  "description": "Machine-readable SSOT for 20 foundation modules (+ L2.5 domainx) behavior/security/identity/CI-gate rules. Dependency rules remain in FOUNDATION-DEPS.yaml; this file does not duplicate them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated",
    "ssot_note",
    "common_rules",
    "modules",
    "dimensions",
    "consumers"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ssot_note": {
      "type": "string"
    },
    "common_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel",
        "configx",
        "observex",
        "resiliencx",
        "schedulex",
        "testkitx",
        "bootstrap",
        "xlib-standard",
        "xlib-harness",
        "xlib-evidence",
        "xlibgate",
        "redisx",
        "kafkax",
        "natsx",
        "postgresx",
        "taosx",
        "ossx",
        "clickhousex",
        "contracts",
        "transportx",
        "domainx"
      ],
      "properties": {
        "kernel":        { "$ref": "#/$defs/module" },
        "configx":       { "$ref": "#/$defs/module" },
        "observex":      { "$ref": "#/$defs/module" },
        "resiliencx":    { "$ref": "#/$defs/module" },
        "schedulex":     { "$ref": "#/$defs/module" },
        "testkitx":      { "$ref": "#/$defs/module" },
        "bootstrap":     { "$ref": "#/$defs/module" },
        "xlib-standard": { "$ref": "#/$defs/module" },
        "xlib-harness":  { "$ref": "#/$defs/module" },
        "xlib-evidence": { "$ref": "#/$defs/module" },
        "xlibgate":      { "$ref": "#/$defs/module" },
        "redisx":        { "$ref": "#/$defs/module" },
        "kafkax":        { "$ref": "#/$defs/module" },
        "natsx":         { "$ref": "#/$defs/module" },
        "postgresx":     { "$ref": "#/$defs/module" },
        "taosx":         { "$ref": "#/$defs/module" },
        "ossx":          { "$ref": "#/$defs/module" },
        "clickhousex":   { "$ref": "#/$defs/module" },
        "contracts":     { "$ref": "#/$defs/module" },
        "transportx":    { "$ref": "#/$defs/module" },
        "domainx":       { "$ref": "#/$defs/module" }
      }
    },
    "dimensions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 11,
      "uniqueItems": true
    },
    "consumers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci_scripts", "xlibgate", "handoff_to_foundation_deps"],
      "properties": {
        "ci_scripts": { "type": "array" },
        "xlibgate": { "type": "array" },
        "handoff_to_foundation_deps": { "type": "object" }
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "rules"],
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L1-test",
            "L2.5",
            "standard-source",
            "harness",
            "evidence",
            "gate",
            "storage",
            "contracts"
          ]
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" },
          "minItems": 1
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "check",
        "fail_condition",
        "reason_code",
        "exit_code",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-\\d{3}-[A-Za-z0-9-]+$",
          "description": "Prefix matches module short-name or CO (common); 3-digit zero-padded number; kebab-case suffix (lower or upper allowed for readability)."
        },
        "dimension": {
          "type": "string",
          "enum": [
            "dependency",
            "boundary",
            "concurrency",
            "state",
            "freeze",
            "observability",
            "security",
            "toolchain",
            "test",
            "release",
            "identity"
          ]
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "fail_condition": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "exit_code": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "0=pass, 1=fail, 2=error. Aligned with FOUNDATION-DEPS.yaml trust_hardening.exit_codes."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Points to FOUNDATION-DEPS.yaml, SPEC.md section, or CONSTITUTION article that this rule encodes."
        },
        "evidence": {
          "type": "string",
          "description": "CI script or xlibgate command that enforces this rule. Empty string = document-only (待 FOLLOWUP-2 接入机器门禁)."
        }
      }
    }
  }
}
