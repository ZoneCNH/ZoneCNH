{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZoneCNH/ZoneCNH/.foundationx/repo-contract.schema.json",
  "title": "FoundationX Aggregate Repo Contract",
  "description": "Machine-readable aggregate contract for Foundation v2 fact sources, xlib roles, projection guards, and trust-hardening policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "updated",
    "repo",
    "foundation",
    "xlib_roles",
    "exit_codes",
    "reason_codes",
    "maturity_dimensions",
    "projection_guards",
    "trust_hardening"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "foundation.repo-contract/v1"
    },
    "contract_version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "module_count",
        "go_baseline",
        "deps_matrix",
        "current_sources",
        "historical_sources"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "module_count": {
          "type": "integer",
          "minimum": 1
        },
        "go_baseline": {
          "type": "string"
        },
        "deps_matrix": {
          "type": "string"
        },
        "current_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "historical_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "xlib_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "exit_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "policy_failure",
        "tool_error"
      ],
      "properties": {
        "pass": {
          "const": 0
        },
        "policy_failure": {
          "const": 1
        },
        "tool_error": {
          "const": 2
        }
      }
    },
    "reason_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_failures",
        "tool_errors"
      ],
      "properties": {
        "policy_failures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tool_errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "maturity_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "projection_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_docs",
        "release_manifest",
        "fact_sources",
        "audit_scripts",
        "rules"
      ],
      "properties": {
        "public_docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "release_manifest": {
          "type": "string"
        },
        "fact_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "audit_scripts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "trust_hardening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset",
        "status_source",
        "blocker_source",
        "policy_rules"
      ],
      "properties": {
        "ruleset": {
          "type": "string"
        },
        "status_source": {
          "type": "string"
        },
        "blocker_source": {
          "type": "string"
        },
        "policy_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
