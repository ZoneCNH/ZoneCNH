{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZoneCNH/ZoneCNH/.foundationx/repo-contract.schema.json",
  "title": "FoundationX Repo Contract",
  "description": "Machine-readable module identity, version, maturity, and boundary contract for xlibgate consumption.",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "identity",
    "versions",
    "maturity",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "repo-contract/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "object",
      "required": [
        "name",
        "owner",
        "url",
        "module"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "const": "ZoneCNH"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "module": {
          "type": "string"
        },
        "default_branch": {
          "type": "string",
          "default": "main"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "layer",
        "readme_h1",
        "public_package",
        "is_standard_source",
        "is_generator",
        "production_import_allowed"
      ],
      "properties": {
        "layer": {
          "enum": [
            "standard-source",
            "harness",
            "evidence",
            "gate",
            "L0",
            "L1",
            "L2",
            "contracts",
            "domain-shared"
          ]
        },
        "kind": {
          "type": "string"
        },
        "readme_h1": {
          "type": "string"
        },
        "public_package": {
          "type": "string"
        },
        "standard_source": {
          "type": "string"
        },
        "is_standard_source": {
          "type": "boolean"
        },
        "is_generator": {
          "type": "boolean"
        },
        "is_harness_runtime": {
          "type": "boolean"
        },
        "is_template_reference": {
          "type": "boolean"
        },
        "production_import_allowed": {
          "type": "boolean"
        },
        "test_only": {
          "type": "boolean"
        }
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "table_version",
        "latest_git_tag",
        "all_aligned"
      ],
      "properties": {
        "table_version": {
          "type": "string"
        },
        "go_module_version": {
          "type": "string"
        },
        "latest_git_tag": {
          "type": "string"
        },
        "github_latest_release": {
          "type": "string"
        },
        "changelog_latest": {
          "type": "string"
        },
        "manifest_latest": {
          "type": "string"
        },
        "all_aligned": {
          "type": "boolean"
        }
      }
    },
    "maturity": {
      "type": "object",
      "required": [
        "spec_complete",
        "implementation_complete",
        "factory_grade_allowed"
      ],
      "properties": {
        "spec_complete": {
          "type": "boolean"
        },
        "implementation_complete": {
          "type": "boolean"
        },
        "traceability_complete": {
          "type": "boolean"
        },
        "unit_tests_complete": {
          "type": "boolean"
        },
        "contract_tests_complete": {
          "type": "boolean"
        },
        "integration_tests_complete": {
          "type": "boolean"
        },
        "live_integration_complete": {
          "type": "boolean"
        },
        "failure_profiles_complete": {
          "type": "boolean"
        },
        "release_manifest_complete": {
          "type": "boolean"
        },
        "external_ci_artifacts_complete": {
          "type": "boolean"
        },
        "downstream_adoption_complete": {
          "type": "boolean"
        },
        "production_soak_complete": {
          "type": "boolean"
        },
        "factory_grade_allowed": {
          "type": "boolean"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "stdlib_only": {
          "type": "boolean"
        },
        "depends_on_kernel": {
          "type": "boolean"
        },
        "depends_on_testkitx_in_production": {
          "type": "boolean"
        },
        "depends_on_x_go": {
          "type": "boolean"
        },
        "reads_real_secret_paths": {
          "type": "boolean"
        },
        "logs_secrets": {
          "type": "boolean"
        },
        "creates_global_singletons": {
          "type": "boolean"
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}