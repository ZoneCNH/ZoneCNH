{
  "schema_version": "foundation.repo-contract/v1",
  "contract_version": "v0.5.1-foundation-v2",
  "updated": "2026-06-14",
  "repo": {
    "name": "ZoneCNH",
    "path": "github.com/ZoneCNH/ZoneCNH",
    "role": "foundation-index"
  },
  "foundation": {
    "name": "Foundation v2",
    "module_count": 20,
    "go_baseline": "1.23",
    "deps_matrix": "module/FOUNDATION-DEPS.yaml",
    "current_sources": [
      "module/README.md",
      "module/*/SPEC.md",
      "module/FOUNDATION-DEPS.yaml",
      ".foundationx/repo-contract.json"
    ],
    "historical_sources": [
      "module/FOUNDATION-SPEC.md",
      "module/FOUNDATION-V1.md",
      "module/foundation-modules.md"
    ]
  },
  "xlib_roles": {
    "xlib-standard": "standards, schemas, templates, and reference facts only",
    "xlib-harness": "generator, scaffold, spec-lint, boundary, traceability, format, and template gate runner",
    "xlib-evidence": "CI/release evidence manifest and report runtime",
    "xlibgate": "machine policy gate for repo-contract, imports, go.mod, baseline, secrets, release evidence, and maturity claims"
  },
  "exit_codes": {
    "pass": 0,
    "policy_failure": 1,
    "tool_error": 2
  },
  "reason_codes": {
    "policy_failures": [
      "policy_import_violation",
      "policy_gomod_drift",
      "policy_baseline_mismatch",
      "policy_secret_scan_failure",
      "policy_release_evidence_missing",
      "policy_contract_projection_drift",
      "policy_repo_identity_mismatch",
      "policy_template_residue",
      "policy_maturity_claim_overreach",
      "policy_status_summary_drift",
      "policy_blocker_index_drift",
      "policy_open_blocker_factory_gate",
      "policy_release_factory_inconsistent",
      "policy_projection_overstates_fact_layer"
    ],
    "tool_errors": [
      "tool_config_missing",
      "tool_config_invalid",
      "tool_evidence_parse_error",
      "tool_external_command_error",
      "tool_missing_dependency",
      "tool_io_error",
      "tool_unknown_error"
    ]
  },
  "maturity_dimensions": [
    "spec",
    "implementation",
    "release",
    "live_integration",
    "external_ci",
    "downstream_adoption",
    "production_soak",
    "factory_gate"
  ],
  "projection_guards": {
    "public_docs": [
      "README.md",
      "ARCHITECTURE.md",
      "STATUS.md",
      "module/README.md"
    ],
    "release_manifest": "release/manifest/latest.json",
    "fact_sources": [
      ".foundationx/status/index.json",
      ".foundationx/blockers.json"
    ],
    "audit_scripts": [
      "scripts/audit-status.py",
      ".github/ci/status-consistency-check.sh"
    ],
    "rules": [
      "public projections must not overstate .foundationx/status/index.json",
      "generated claims must fail CI when fact-layer invariants fail"
    ]
  },
  "trust_hardening": {
    "ruleset": "v1.1.2",
    "status_source": ".foundationx/status/index.json",
    "blocker_source": ".foundationx/blockers.json",
    "policy_rules": [
      "summary counts are derived from module entries",
      "release=false forces factory=false",
      "open blocker forces factory=false for that module",
      "open release blocker forces release=false for that module",
      "public projections must not overstate the fact layer"
    ]
  },
  "claim_model": {
    "purpose": "projection consistency guard only; not factory-grade proof",
    "required_inputs": [
      ".foundationx/status/index.json",
      ".foundationx/blockers.json",
      ".foundationx/repo-contract.json",
      "release/trust/index.json"
    ],
    "invariants": [
      "release_manifest must point at release/manifest/latest.json",
      "public_docs must stay bounded to public release docs",
      "factory-grade claims require open blocker review and trust evidence"
    ],
    "factory_grade_requires": [
      "foundation status summary",
      "open blocker review",
      "projection guard",
      "xlibgate trust evidence"
    ]
  }
}
