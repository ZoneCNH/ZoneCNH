            <mxPoint x="400" y="290" as="sourcePoint" />
            <mxPoint x="400" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="step3" value="&lt;b style=&quot;font-size:14px;&quot;&gt;3. 矛盾分类&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;实质矛盾 → 必修&lt;br&gt;粒度差异 → 不修&lt;br&gt;术语差异 → 装饰性，都保留&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e65100;strokeColor=#bf360c;fontColor=#ffffff;arcSize=15;fontSize=12;" vertex="1" parent="1">
