        <!-- Step 1 -->
        <mxCell id="step1" value="&lt;b style=&quot;font-size:14px;&quot;&gt;1. 定位权威源&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;找到项目的最高治理文档&lt;br&gt;FoundationX → CONSTITUTION.md&lt;br&gt;你们的项目 → ？&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#16213e;fontColor=#ffffff;arcSize=15;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="300" height="80" as="geometry" />
        </mxCell>

