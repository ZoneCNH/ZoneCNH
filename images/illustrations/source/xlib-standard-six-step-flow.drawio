        <!-- Step 5 -->
        <mxCell id="step5" value="&lt;b style=&quot;font-size:14px;&quot;&gt;5. grep + 脚本验证&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;全局扫描旧语言 → 归零&lt;br&gt;结构化交叉检查权威要求&lt;br&gt;17 项检查 / 16 PASS / 1 COSMETIC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;strokeColor=#4a148c;fontColor=#ffffff;arcSize=15;fontSize=12;" vertex="1" parent="1">
