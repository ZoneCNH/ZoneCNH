        <!-- Step 2 -->
        <mxCell id="step2" value="&lt;b style=&quot;font-size:14px;&quot;&gt;2. 并行交叉引用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;同时搜索所有治理文档&lt;br&gt;ARCHITECTURE / FOUNDATION-SPEC /&lt;br&gt;FOUNDATION-V1 / module/README&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;arcSize=15;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="210" width="300" height="80" as="geometry" />
        </mxCell>

