            <mxPoint x="400" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="step4" value="&lt;b style=&quot;font-size:14px;&quot;&gt;4. 自上而下修复&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;宪章 → 目标文档 → 规格 →&lt;br&gt;索引 → 任务 → 提示词&lt;br&gt;按文档权威层次逐层修复&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;arcSize=15;fontSize=12;" vertex="1" parent="1">
