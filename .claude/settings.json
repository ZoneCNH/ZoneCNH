{
  "env": {
    "WORKTREE_GC_AUTO": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/post-tool-check.mjs",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "node .claude/hooks/edit-guard-reset.mjs",
            "type": "command"
          }
        ],
        "matcher": "Write"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/workspace/ZoneCNH/.claude/hooks/link-check.cjs"
          }
        ],
        "description": "Link-check after markdown edits"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/rsi-trigger.mjs"
          }
        ],
        "description": "RSI auto-propose after audit FAIL (PostToolUse per script header)"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/pre-compact.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/pre-tool-check.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "node .claude/hooks/edit-guard.mjs",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      },
      {
        "hooks": [
          {
            "command": "node .claude/hooks/count-guard.mjs",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/session-context.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime --mcp --stealth",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node /home/workspace/ZoneCNH/.claude/hooks/session-review.mjs",
            "type": "command"
          },
          {
            "command": "node /home/workspace/ZoneCNH/.claude/hooks/version-guard.mjs",
            "type": "command"
          },
          {
            "command": "node /home/workspace/ZoneCNH/.claude/hooks/branch-protect.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
